---
/* Footer — ink bg, paper text, NavGurukul credit */
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="footer-logo">📓 Ravel</span>
      <span class="footer-tagline">Reflect. Rant. Grow.</span>
    </div>
    <div class="footer-right">
      <nav class="footer-links">
        <a href="#">Privacy</a>
        <a href="#">Terms</a>
        <a href="#">Contact</a>
      </nav>
      <p class="footer-credit">Built with ❤️ by NavGurukul · © 2026</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    padding: 40px 0;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .footer-logo {
    font-family: var(--font-hand);
    font-size: 20px;
    color: var(--paper-warm);
  }
  .footer-tagline {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--ink-light);
  }

  .footer-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }
  .footer-links {
    display: flex;
    gap: 24px;
  }
  .footer-links a {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.5px;
    color: var(--ink-light);
    transition: color 0.15s;
  }
  .footer-links a:hover { color: var(--reflect); }

  .footer-credit {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-faint);
  }

  @media (max-width: 600px) {
    .footer { padding: 32px 0; }
    .footer-inner { flex-direction: column; text-align: center; gap: 20px; }
    .footer-right { align-items: center; }
  }
</style>

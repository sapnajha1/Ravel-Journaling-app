---
/* Hero — "Reflect. Rant." headline, trust badges, paper-first */
---

<section class="hero">
  <div class="container hero-inner">
    <!-- Badge -->
    <span class="hero-badge">
      <span class="star-icon">✦</span>
      <div class="typewriter-container">
        <span id="typewriterText"></span>
        <span class="pencil-cursor" id="pencilCursor">🖊️</span>
      </div>
    </span>

    <!-- Headline -->
    <h1 class="hero-headline">Your mind deserves a page of its own.</h1>
    <p class="hero-tagline">unfold your mind</p>

    <!-- Subtitle -->
    <p class="hero-subtitle">
      A journaling app that meets you where you are.
      Write when you're thoughtful, speak when you're heated.
      AI understands your mood — you own every word.
    </p>

    <!-- CTAs -->
    <div class="hero-ctas">
      <a href="#download" class="download-btn android-btn" onclick="alert('🤖 Android app coming soon! Stay tuned.'); return false;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.61 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/>
        </svg>
        Download for Android
      </a>
      
      <a href="#download" class="download-btn ios-btn" onclick="alert('🍎 iOS app coming soon! Stay tuned.'); return false;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.71,19.5C17.88,20.74 17,21.95 15.66,21.97C14.32,22 13.89,21.18 12.37,21.18C10.84,21.18 10.37,21.95 9.1,22C7.79,22.05 6.8,20.68 5.96,19.47C4.25,17 2.94,12.45 4.7,9.39C5.57,7.87 7.13,6.91 8.82,6.88C10.1,6.86 11.32,7.75 12.11,7.75C12.89,7.75 14.37,6.68 15.92,6.84C16.57,6.87 18.39,7.1 19.56,8.82C19.47,8.88 17.39,10.1 17.41,12.63C17.44,15.65 20.06,16.66 20.09,16.67C20.06,16.74 19.67,18.11 18.71,19.5M13,3.5C13.73,2.67 14.94,2.04 15.94,2C16.07,3.17 15.6,4.35 14.9,5.19C14.21,6.04 13.07,6.7 11.95,6.61C11.8,5.46 12.36,4.26 13,3.5Z"/>
        </svg>
        Download for iOS
      </a>
    </div>

    <!-- Trust badges -->
    <div class="trust-row">
      <span class="trust-badge">🔒 Encrypted</span>
      <span class="trust-badge">� History Stored</span>
      <span class="trust-badge">✨ AI Insights</span>
    </div>
  </div>
</section>

<style>
  .hero { padding: 80px 0 64px; }
  .hero-inner { text-align: center; }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--reflect-dark);
    background: var(--reflect-light);
    border: 1px solid var(--reflect-border);
    border-radius: 20px;
    padding: 6px 16px;
    position: relative;
  }

  .star-icon {
    display: inline-block;
  }

  .typewriter-container {
    display: inline-flex;
    align-items: center;
    min-height: 14px;
    width: 280px;  /* Fixed width - notebook size doesn't change */
    overflow: hidden;
    white-space: nowrap;
  }

  .badge-text {
    min-height: 14px;
    overflow: hidden;
    white-space: nowrap;
  }

  .pencil-cursor {
    font-size: 10px;
    animation: pencilBob 2s ease-in-out infinite;
    margin-left: 2px;
    opacity: 0;
    transition: opacity 0.3s ease;
    flex-shrink: 0;
  }

  .pencil-cursor.show {
    opacity: 1;
  }

  @keyframes pencilBob {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-2px) rotate(5deg); }
  }

  .hero-headline {
    font-family: var(--font-hand);
    font-size: 64px;
    line-height: 1.15;
    color: var(--ink);
    margin-top: 28px;
  }

  .hero-tagline {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 4px;
    text-transform: uppercase;
    /* color: var(--ink-light); */
    color: #3a7f5a;
    margin-top: 4px;
  }

  .hero-subtitle {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.6;
    color: #333333;
    max-width: 560px;
    margin: 24px auto 0;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
    margin-top: 36px;
  }

  .cta {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    padding: 14px 28px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .download-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    padding: 14px 24px;
    border-radius: 6px;
    border: 1.5px solid;
    cursor: pointer;
    transition: all 0.18s ease;
    text-decoration: none;
  }

  .android-btn {
    background: var(--reflect);
    color: #fff;
    border-color: var(--reflect-dark);
    box-shadow: 3px 3px 0 var(--reflect-shadow);
  }
  .android-btn:hover {
    background: var(--reflect-dark);
    box-shadow: none;
    transform: translate(2px, 2px);
  }

  .ios-btn {
    background: var(--rant);
    color: #fff;
    border-color: var(--rant-dark);
    box-shadow: 3px 3px 0 var(--rant-shadow);
  }
  .ios-btn:hover {
    background: var(--rant-dark);
    box-shadow: none;
    transform: translate(2px, 2px);
  }
  .cta-primary {
    background: var(--reflect);
    color: #fff;
    border: 1.5px solid var(--reflect-dark);
    box-shadow: 3px 3px 0 var(--reflect-shadow);
  }
  .cta-primary:hover {
    background: var(--reflect-dark);
    box-shadow: none;
    transform: translate(2px, 2px);
  }
  .cta-secondary {
    background: var(--paper-cream);
    color: var(--ink);
    border: 1.5px solid var(--ink-ghost);
    box-shadow: 3px 3px 0 rgba(181, 173, 164, 0.28);
  }
  .cta-secondary:hover {
    background: var(--paper-warm);
    box-shadow: none;
    transform: translate(2px, 2px);
  }

  .trust-row {
    display: flex;
    gap: 24px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 32px;
  }
  .trust-badge {
    font-family: var(--font-mono);
    font-size: 14px;
    color: #2f2f2f;
  }

  @media (max-width: 600px) {
    .hero { padding: 56px 0 48px; }
    .hero-headline { font-size: 44px; }
    .hero-tagline { font-size: 11px; }
    .hero-ctas { flex-direction: column; align-items: center; }
  }
</style>

<script>
// Typewriter effect — pencil stays beside last letter (inline flow)
document.addEventListener('DOMContentLoaded', function() {
  const typewriterText = document.getElementById('typewriterText');
  const pencilCursor = document.getElementById('pencilCursor');
  const fullText = 'your thoughts deserve a beautiful home';
  let currentText = '';
  let charIndex = 0;
  
  // Start with empty container
  typewriterText.textContent = '';
  
  // Show pencil first, then start typing
  setTimeout(function() {
    pencilCursor.classList.add('show');
    
    setTimeout(function() {
      typeWriter();
    }, 300);
  }, 800);
  
  function typeWriter() {
    if (charIndex < fullText.length) {
      currentText += fullText.charAt(charIndex);
      typewriterText.textContent = currentText;
      charIndex++;
      setTimeout(typeWriter, 80);
    }
    // Pencil stays at the end — no hiding
  }
});
</script>

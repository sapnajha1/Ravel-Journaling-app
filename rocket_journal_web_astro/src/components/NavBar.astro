---
/* NavBar — sticky, paper bg, 📓 Ravel logo, amber CTA */
---

<nav class="navbar">
  <div class="container nav-inner">
    <a href="/" class="logo">
      <span class="logo-icon">📓</span>
      <span class="logo-text">Ravel</span>
    </a>
    <a href="#download" class="nav-cta">Coming Soon</a>
  </div>
</nav>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(242, 237, 228, 0.95);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(27, 42, 74, 0.1);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 14px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .logo-icon { font-size: 22px; }
  .logo-text {
    font-family: var(--font-hand);
    font-size: 24px;
    color: var(--ink);
  }
  .nav-cta {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    padding: 10px 22px;
    background: var(--reflect);
    color: #fff;
    border: 1.5px solid var(--reflect-dark);
    border-radius: 6px;
    box-shadow: 3px 3px 0 var(--reflect-shadow);
    cursor: pointer;
    transition: all 0.18s ease;
  }
  .nav-cta:hover {
    background: var(--reflect-dark);
    box-shadow: none;
    transform: translate(2px, 2px);
  }

  @media (max-width: 600px) {
    .logo-text { font-size: 20px; }
    .nav-cta { padding: 8px 16px; font-size: 12px; }
  }
</style>

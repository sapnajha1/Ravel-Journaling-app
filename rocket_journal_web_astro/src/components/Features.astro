  .mood-tag {
    font-family: var(--font-mono);
    font-size: 9px;
    padding: 3px 8px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--tag-color) 12%, white);
    color: var(--tag-color);
    border: 1px solid color-mix(in srgb, var(--tag-color) 25%, transparent);
    opacity: 0;
    transform: translateY(6px) scale(0.9);
  }

  .tag-1 { animation: tagPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 5.2s forwards; }
  .tag-2 { animation: tagPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 5.5s forwards; }
  .tag-3 { animation: tagPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 5.8s forwards; }
  .tag-4 { animation: tagPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 6.1s forwards; }

  @keyframes tagPop {
    0%   { opacity: 0; transform: translateY(6px) scale(0.9); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }

  .insight-divider {
    height: 1px;
    background: var(--reflect-border);
    margin: 0;
    opacity: 0;
    animation: fadeIn 0.3s ease 6.5s forwards;
  }

  @keyframes fadeIn {
    to { opacity: 1; }
  }

  .margin-note {
    padding: 12px 14px 16px;
    opacity: 0;
    animation: noteSlideUp 0.5s ease 6.8s forwards;
  }

  @keyframes noteSlideUp {
    0%   { opacity: 0; transform: translateY(10px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .margin-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--insight);
    background: var(--insight-light);
    padding: 2px 7px;
    border-radius: 4px;
  }

  .insight-quote {
    font-family: var(--font-serif);
    font-size: 12px;
    font-weight: 300;
    font-style: italic;
    line-height: 1.7;
    color: var(--ink);
    margin-top: 8px;
    padding-left: 10px;
    border-left: 2px solid var(--insight);
  }

  .q-word {
    opacity: 0;
    animation: wordFade 0.15s ease forwards;
    animation-delay: calc(7.2s + var(--d) * 0.09s);
  }

  @keyframes wordFade {
    to { opacity: 1; }
  }

  .insight-meta {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--ink-faint);
    margin-top: 10px;
    opacity: 0;
    animation: fadeIn 0.4s ease 9.5s forwards;
  }

  .scanning-badge.done {
    color: var(--insight);
    background: var(--insight-light);
  }

  .scanning-badge.done .scan-spinner {
    display: none;
  }

  /* ═══ Mobile responsive ═══ */
  @media (max-width: 768px) {
    .features { padding: 56px 0; }
    .section-title { font-size: 32px; }
    .feature-row,
    .feature-row-reverse {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    /* On mobile, phone always comes first */
    .feature-row-reverse .phone-wrapper { order: -1; }
    .phone { width: 200px; height: 460px}
    .feature-heading { font-size: 36px; }
    .feature-text { max-width: 100%; text-align: center; }
    .feature-bullets { align-items: center; }
  }
</style>

<script>
  // Animate the REC timer counting up
  const timeEl = document.querySelector('.rec-time');
  if (timeEl) {
    let sec = 12;
    setInterval(() => {
      sec = (sec + 1) % 60;
      const m = Math.floor(sec / 60);
      const s = sec % 60;
      timeEl.textContent = `${m}:${s.toString().padStart(2, '0')}`;
    }, 1000);
  }

  // Restart writing + transcript animations when scrolled into view
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const els = entry.target.querySelectorAll(
          '.write-line, .transcript-line, .pencil, .cursor, .reflect-prompt, .go-deeper-btn'
        );
        els.forEach(el => {
          el.style.animation = 'none';
          el.offsetHeight;
          el.style.animation = '';
        });
      }
    });
  }, { threshold: 0.3 });

  document.querySelectorAll('.feature-row').forEach(row => observer.observe(row));

  // AI Insights Animation
  const insightCard = document.getElementById('insightCard');
  if (insightCard) {
    const insightObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          restartAiAnimation(insightCard);
        }
      });
    }, { threshold: 0.35 });

    insightObserver.observe(insightCard);
  }

  function restartAiAnimation(card) {
    // Reset all animations
    const animatedElements = card.querySelectorAll('.scanning-badge, .scan-bar, .mood-tag, .insight-divider, .margin-note, .q-word, .insight-meta');
    animatedElements.forEach(el => {
      el.style.animation = 'none';
      el.offsetHeight; // trigger reflow
      el.style.animation = '';
    });

    // Reset scanned state
    const jLines = card.querySelectorAll('.j-line');
    jLines.forEach(line => line.removeAttribute('data-scanned'));

    // Reset scanning badge
    const badge = card.querySelector('.scanning-badge');
    if (badge) {
      badge.classList.remove('done');
      badge.innerHTML = '<span class="scan-spinner"></span> Analyzing…';
    }

    // Animate scanning each line
    const scanDelay = 800;
    const lineDelay = 800;
    jLines.forEach((line, i) => {
      setTimeout(() => {
        line.setAttribute('data-scanned', 'true');
      }, scanDelay + (i + 1) * lineDelay);
    });

    // Complete scanning
    setTimeout(() => {
      if (badge) {
        badge.classList.add('done');
        badge.innerHTML = '✓ Complete';
      }
    }, scanDelay + jLines.length * lineDelay + 300);
  }
</script>
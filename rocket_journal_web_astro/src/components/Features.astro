  /* ═══════════════════════════════════════
     RANT — Mic + Waveform + Transcript
     ═══════════════════════════════════════ */
  .rant-anim {
    overflow: hidden;
  }

  .rant-page {
    position: relative;
    background: #F5F7FA;
    padding: 14px 14px 0 14px;
    min-height: 280px;

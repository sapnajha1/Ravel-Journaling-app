  }

  .line-1 { animation: typeLine 1.8s steps(30) 1s forwards; }
  .line-2 { animation: typeLine 1.6s steps(28) 3s forwards; }
  .line-3 { animation: typeLine 1.6s steps(26) 5s forwards; }
  .line-4 { animation: typeLine 1.4s steps(24) 7s forwards; }


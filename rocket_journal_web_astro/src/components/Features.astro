  /* ═══ AI Insights Animation Styles ═══ */
  .scan-phase {
    padding: 14px 14px 10px;
  }

  .scan-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .scan-date {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-faint);
    letter-spacing: 0.5px;
  }

  .scanning-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--insight);
    background: var(--insight-light);
    padding: 2px 8px;
    border-radius: 10px;
    opacity: 0;
    animation: fadeIn 0.3s ease 0.3s forwards;
  }

  .scan-spinner {
    width: 8px;
    height: 8px;
    border: 1.5px solid rgba(125, 155, 118, 0.3);
    border-top-color: var(--insight);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .journal-lines {
    position: relative;
    padding: 2px 0;
  }

  .j-line {
    font-family: var(--font-hand);
    font-size: 12px;
    line-height: 22px;
    height: 22px;
    color: var(--ink);
    position: relative;
    transition: color 0.3s ease;
  }

  .scan-bar {
    position: absolute;
    left: -4px;
    right: -4px;
    height: 22px;
    top: 0;
    background: linear-gradient(90deg,
      transparent 0%,
      rgba(125, 155, 118, 0.12) 15%,
      rgba(125, 155, 118, 0.25) 50%,
      rgba(125, 155, 118, 0.12) 85%,
      transparent 100%);
    border-radius: 3px;
    opacity: 0;
    animation: scanDown 4s ease-in-out 0.8s forwards;
  }

  @keyframes scanDown {
    0%   { top: 0; opacity: 0; }
    5%   { opacity: 1; }
    20%  { top: 0; }
    35%  { top: 22px; }
    50%  { top: 44px; }
    65%  { top: 66px; }
    80%  { top: 88px; }
    90%  { top: 88px; opacity: 1; }
    100% { top: 88px; opacity: 0; }
  }

  .j-line[data-scanned="true"] {
    color: var(--ink-soft);
  }

  .j-line[data-scanned="true"]:after {
    content: "";
    position: absolute;
    right: -2px;
    top: 50%;
    transform: translateY(-50%);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--insight);
    opacity: 0;
    animation: dotPop 0.3s ease forwards;
  }

  @keyframes dotPop {
    0%   { transform: translateY(-50%) scale(0); opacity: 0; }
    60%  { transform: translateY(-50%) scale(1.3); opacity: 1; }
    100% { transform: translateY(-50%) scale(1); opacity: 0.6; }
  }

  .mood-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
    min-height: 24px;

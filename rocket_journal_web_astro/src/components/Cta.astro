---
/* CTA — amber gradient, Android/iOS download buttons */
---

<section class="cta-section" id="download">
  <div class="container cta-inner">
    <h2 class="cta-title">Start Your Journal</h2>
    <p class="cta-desc">Your thoughts are worth keeping. Start reflecting and ranting today.</p>
    
    <div class="download-buttons">
      <a href="#" class="download-btn android-btn" onclick="alert('🤖 Android app coming soon! Stay tuned.'); return false;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.61 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/>
        </svg>
        Download App
      </a>
      
      <a href="#" class="download-btn ios-btn" onclick="alert('🍎 iOS app coming soon! Stay tuned.'); return false;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.71,19.5C17.88,20.74 17,21.95 15.66,21.97C14.32,22 13.89,21.18 12.37,21.18C10.84,21.18 10.37,21.95 9.1,22C7.79,22.05 6.8,20.68 5.96,19.47C4.25,17 2.94,12.45 4.7,9.39C5.57,7.87 7.13,6.91 8.82,6.88C10.1,6.86 11.32,7.75 12.11,7.75C12.89,7.75 14.37,6.68 15.92,6.84C16.57,6.87 18.39,7.1 19.56,8.82C19.47,8.88 17.39,10.1 17.41,12.63C17.44,15.65 20.06,16.66 20.09,16.67C20.06,16.74 19.67,18.11 18.71,19.5M13,3.5C13.73,2.67 14.94,2.04 15.94,2C16.07,3.17 15.6,4.35 14.9,5.19C14.21,6.04 13.07,6.7 11.95,6.61C11.8,5.46 12.36,4.26 13,3.5Z"/>
        </svg>
        Download App
      </a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    background: linear-gradient(135deg, var(--cover-dark), var(--cover), #A8854D);
    padding: 80px 0;
    text-align: center;
  }

  .cta-title {
    font-family: var(--font-hand);
    font-size: 48px;
    color: #fff;
    line-height: 1.2;
  }
  .cta-desc {
    font-family: var(--font-mono);
    font-size: 15px;
    color: rgba(255,255,255,0.88);
    max-width: 440px;
    margin: 12px auto 0;
  }

  .download-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 32px;
  }

  .download-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    padding: 16px 28px;
    border-radius: 8px;
    transition: all 0.18s ease;
    cursor: pointer;
    min-width: 140px;
  }
  
  .download-btn:hover {
    box-shadow: none;
    transform: translate(2px, 2px);
  }

  .download-btn svg {
    width: 20px;
    height: 20px;
  }

  .android-btn {
    background: var(--reflect);
    border: 2px solid var(--reflect-dark);
    box-shadow: 3px 4px 0 var(--reflect-shadow);
  }
  .android-btn:hover {
    background: var(--reflect-dark);
  }
  
  .ios-btn {
    background: var(--rant);
    border: 2px solid var(--rant-dark);
    box-shadow: 3px 4px 0 var(--rant-shadow);
  }
  .ios-btn:hover {
    background: var(--rant-dark);
  }

  .cta-fine {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1px;
    color: rgba(255,255,255,0.7);
    margin-top: 16px;
  }

  @media (max-width: 600px) {
    .cta-section { padding: 56px 0; }
    .cta-title { font-size: 34px; }
  }
</style>
